{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@modeltruth/audit-engine": ["packages/audit-engine/src/index.ts"],
      "@modeltruth/config": ["packages/config/src/index.ts"],
      "@modeltruth/crypto": ["packages/crypto/src/index.ts"],
      "@modeltruth/db": ["packages/db/src/index.ts"],
      "@modeltruth/i18n": ["packages/i18n/src/index.ts"],
      "@modeltruth/seo": ["packages/seo/src/index.ts"],
      "@modeltruth/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
