{
  "name": "modeltruth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=11.7.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:init && npm -w @modeltruth/web run dev",
    "build": "npm run db:init && npm -w @modeltruth/web run build",
    "start": "npm run db:init && npm -w @modeltruth/web run start:raw",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run engineering:validate && npm run third-party:validate && npm run security:audit && npm run audit-suite:governance && npm run live-smoke:gate && npm run docker:validate && npm run db:init && npm run db:validate && npm run db:final-check && npm run build && npm run release:governance",
    "docker:validate": "tsx scripts/validate-docker-context.ts",
    "engineering:validate": "tsx scripts/validate-engineering-discipline.ts",
    "third-party:validate": "tsx scripts/validate-third-party-notices.ts",
    "audit-suite:governance": "tsx scripts/validate-audit-suite-governance.ts",
    "live-smoke:gate": "tsx scripts/live-smoke-gate.ts",
    "postgres:migration-smoke": "tsx scripts/postgres-migration-smoke.ts",
    "db:init": "tsx scripts/db-init.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:validate": "tsx scripts/validate-db-schema.ts",
    "db:final-check": "tsx scripts/final-migration-check.ts",
    "release:governance": "tsx scripts/performance-release-governance.ts",
    "security:audit": "npm audit --audit-level=critical",
    "model-registry:seed": "tsx scripts/seed-model-registry.ts",
    "secrets:rotate-key": "tsx scripts/rotate-encryption-key.ts",
    "healthcheck": "tsx scripts/healthcheck.ts"
  },
  "dependencies": {
    "next": "15.5.18",
    "postgres": "3.4.9",
    "promptfoo": "0.121.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
